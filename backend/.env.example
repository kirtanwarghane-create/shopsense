# Required: Groq API key used for chat completions
GROQ_API_KEY=your_groq_api_key_here

# Optional: Tavily API key used for current product searches
# Without this key, chat still works but live search is disabled.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional settings
GROQ_MODEL=llama-3.3-70b-versatile
PORT=5000
